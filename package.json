  },
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "description": "Monitors DOM structure changes on target websites to protect web scraping pipelines from breaking silently.",
  "keywords": [
    "dom",
    "dom-diff",
    "html-diff",
    "change-detection",
    "ui-regression",
    "regression-testing",
    "test-automation",
    "playwright",
    "dom-analysis",
    "html-analysis",
    "page-monitoring",
    "developer-tools"
  ],
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "funding": "https://github.com/sponsors/ticuong78",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run --reporter=verbose",
    "test:unit": "vitest run --reporter=verbose tests/unit",
    "test:integration": "vitest run --reporter=verbose tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  }
}
